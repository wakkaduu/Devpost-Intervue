# Copy to .env.local and fill in. Never commit .env.local.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-lite-latest

# Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-a-long-random-string
# Needed when running the production build yourself (npm run build && npm start) or self-hosting.
# Vercel sets this up automatically. Only enable it on a host you control, behind your own domain.
AUTH_TRUST_HOST=true

# Supabase (Project Settings > API). The service-role key is server-only: never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional social sign-in. A button appears only when both the id and secret are set.
# Callback URLs: http://localhost:3000/api/auth/callback/google, .../github and .../facebook
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Email confirmation codes (Resend). Until you verify a domain, use onboarding@resend.dev as the sender;
# Resend then delivers only to the email address of your own Resend account.
RESEND_API_KEY=your-resend-key
EMAIL_FROM=Intervue <onboarding@resend.dev>

# Backup AI reviewer and speech-to-text (free key at console.groq.com/keys)
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
