# Copy to .env.local and fill in. Never commit .env.local.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-lite-latest

# Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-a-long-random-string

# Supabase (Project Settings > API). The service-role key is server-only: never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
