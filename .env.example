# Copy to .env.local and fill in. Never commit .env.local.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-lite-latest
# Optional: the server voice used when a browser cannot speak by itself (for example Brave on Linux).
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore

# Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-a-long-random-string
# Needed when running the production build yourself (npm run build && npm start) or self-hosting.
# Vercel sets this up automatically. Only enable it on a host you control, behind your own domain.
AUTH_TRUST_HOST=true

# Supabase (Project Settings > API). The service-role key is server-only: never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional social sign-in. A button appears only when both the id and secret are set.
# Callback URLs: http://localhost:3000/api/auth/callback/google, .../github and .../facebook
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Email confirmation codes, sent over SMTP with nodemailer. For Gmail: turn on 2-Step Verification, then create an
# app password at myaccount.google.com/apppasswords and paste it below (not your normal password).
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-letter-app-password
# Optional: defaults to Gmail (smtp.gmail.com, port 465, SSL). Change these for another mail service, for example
# Brevo (free, no domain needed): SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_SECURE=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# Optional: the From line. Defaults to "Intervue <SMTP_USER>". Gmail may rewrite it to your own address.
# EMAIL_FROM=Intervue <you@gmail.com>

# Backup AI reviewer and speech-to-text (free key at console.groq.com/keys)
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
